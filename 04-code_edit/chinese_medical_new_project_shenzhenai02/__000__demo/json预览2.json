      "attributes": {
        "origin": "为旋花科植物白鹤藤的茎叶",
        "property_flavor": "苦辛，凉；味微酸微苦，性凉",
        "effect": "化痰止咳，理血祛风",
        "indication": "治热咳，痰喘，吐血，崩漏，白带，跌打损伤，风湿痛，疮毒",
        "dosage": "内服：煎汤，9~15克。外用：煎水熏洗或捣敷",
        "place": "分布于广东、海南、广西等地",
        "processing": "秋季采收",
        "taboo": null,
        "meridian": null,
        "traits": "干燥茎叶，茎扭曲，表面暗灰棕色，有纵沟纹，断面绿白色，有明显的维管束，淡棕色。叶稍卷曲，质脆易碎，表面暗棕色至紫色，背面浅灰绿色，紧贴丝光毛。触之柔软"
      }
